{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 4.5,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 20,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Association for Psychological Science",
        "url": "https://www.psychologicalscience.org/feed",
        "enabled": true,
        "category": "psychology",
        "profile": "tech-news",
        "fetch_limit": 12,
        "max_items": 10
      },
      {
        "name": "PNAS",
        "url": "https://www.pnas.org/action/showFeed?type=etoc&feed=rss&jc=pnas",
        "enabled": true,
        "category": "psychology-research",
        "profile": "tech-news",
        "content_extractor": "trafilatura",
        "max_items": 15
      },
      {
        "name": "ScienceDaily Psychology",
        "url": "https://www.sciencedaily.com/rss/mind_brain/psychology.xml",
        "enabled": true,
        "category": "psychology",
        "profile": "tech-news",
        "max_items": 6
      },
      {
        "name": "Mind Hacks",
        "url": "https://www.mindhacks.com/rss.xml",
        "enabled": true,
        "category": "psychology",
        "profile": "tech-news",
        "content_extractor": "trafilatura",
        "fetch_limit": 8
      },
      {
        "name": "Psyche (Aeon)",
        "url": "https://psyche.co/feed.rss",
        "enabled": true,
        "category": "psychology",
        "profile": "tech-news",
        "content_extractor": "trafilatura",
        "fetch_limit": 6,
        "max_items": 6
      },
      {
        "name": "Nature Psychology",
        "url": "https://www.nature.com/subjects/psychology.rss",
        "enabled": true,
        "category": "psychology-research",
        "profile": "tech-news",
        "content_extractor": "trafilatura",
        "fetch_limit": 12,
        "max_items": 15
      },
      {
        "name": "npj Science of Learning",
        "url": "https://www.nature.com/npjscilearn.rss",
        "enabled": true,
        "category": "psychology-research",
        "profile": "tech-blog",
        "content_extractor": "trafilatura",
        "fetch_limit": 6,
        "max_items": 6
      },
      {
        "name": "ScienceDaily Mind & Brain",
        "url": "https://www.sciencedaily.com/rss/mind_brain.xml",
        "enabled": true,
        "category": "psychology",
        "profile": "tech-news",
        "fetch_limit": 10,
        "max_items": 6
      },
      {
        "name": "Biological Psychology (Elsevier)",
        "url": "https://rss.sciencedirect.com/publication/science/00016918",
        "enabled": true,
        "category": "psychology-research",
        "profile": "tech-news",
        "fetch_limit": 8,
        "max_items": 8
      },
      {
        "name": "Aeon",
        "url": "https://aeon.co/feed.rss",
        "enabled": false,
        "category": "psychology",
        "profile": "tech-blog",
        "content_extractor": "trafilatura",
        "fetch_limit": 0
      },
      {
        "name": "Neuroanthropology",
        "url": "https://neuroanthropology.net/feed/",
        "enabled": false,
        "category": "psychology-research",
        "profile": "tech-news",
        "fetch_limit": 0
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "profile": [
            "tech-news",
            "finance-news"
          ]
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 3,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}